# Copy this file to .env and fill in the values. Never commit .env.

# --- Required ---
# A long random string; generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# --- Optional ---
WEB_PORT=8080
TOKEN_HOURS=8
APP_TIMEZONE=Asia/Kolkata

# Outgoing email and WhatsApp. With SEND_MESSAGES=0 every notification is only stored (status "Logged").
SEND_MESSAGES=0
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Myjo Publications <no-reply@myjo.in>
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=

# Only for running the back end outside Docker
# DATABASE_URL=mysql+pymysql://myjo:PASSWORD@127.0.0.1:3306/myjo_portal?charset=utf8mb4
# UPLOAD_DIR=/var/lib/myjo/uploads
